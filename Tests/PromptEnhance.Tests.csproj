<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Must match the host's roll-forward policy (vendor/SwarmUI/src/SwarmUI.csproj)
         and ../PromptEnhance.csproj: tests must run on the same runtime the host
         selects, or local multi-runtime machines diverge from CI. -->
    <RollForward>Major</RollForward>
    <!-- xunit.v3 test projects are stand-alone executables; the built app speaks the
         Microsoft Testing Platform CLI when run directly (path C). -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>true</IsTestProject>
    <!-- Project-anchored path: the gates invoke `dotnet test` from the repo root,
         and MSBuild passes this value to VSTest unresolved. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\.runsettings</RunSettingsFilePath>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Mutually exclusive with the host-layout reference below: in a host checkout
         that also ran vendor-sync, both paths exist, and referencing two SwarmUI
         projects would produce duplicate type identities. Host layout wins,
         mirroring the UseVendoredSwarmUI condition in ../PromptEnhance.csproj. -->
    <ProjectReference Include="..\vendor\SwarmUI\src\SwarmUI.csproj" Condition="Exists('..\vendor\SwarmUI\src\SwarmUI.csproj') and !Exists('..\..\..\SwarmUI.csproj')">
      <Properties>_EnableMacOSCodeSign=false;StaticWebAssetsEnabled=false</Properties>
    </ProjectReference>
    <ProjectReference Include="..\..\..\SwarmUI.csproj" Condition="Exists('..\..\..\SwarmUI.csproj')">
      <Properties>_EnableMacOSCodeSign=false;StaticWebAssetsEnabled=false</Properties>
    </ProjectReference>
    <ProjectReference Include="..\PromptEnhance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
  </ItemGroup>

</Project>
