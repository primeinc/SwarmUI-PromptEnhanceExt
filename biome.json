{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["Frontend/**/*.ts", "Tests/**/*.ts", "Tests/**/*.mts", "!!**/vendor", "!!**/node_modules", "!!**/out", "!!**/test-results"]
    },
    "formatter": {
        "enabled": false
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    }
}
